{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🏛️ Landmark Detection - Data Exploration\n",
    "## Google Landmarks Dataset v2 Analysis\n",
    "\n",
    "**Dataset Stats:** 4,132,914 images across 203,094 landmarks\n",
    "**Source:** [Kaggle](https://www.kaggle.com/datasets/google/google-landmarks-dataset) | [CVDF GitHub](https://github.com/cvdfoundation/google-landmark)\n",
    "\n",
    "---\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import libraries\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "import os\n",
    "import sys\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Settings\n",
    "plt.style.use('seaborn-v0_8-whitegrid')\n",
    "sns.set_palette(\"husl\")\n",
    "\n",
    "# Paths\n",
    "PROJECT_ROOT = Path('../').resolve()\n",
    "TRAIN_CSV = PROJECT_ROOT / 'train.csv'\n",
    "IMAGES_DIR = PROJECT_ROOT / 'images_000'\n",
    "DATA_DIR = PROJECT_ROOT / 'data'\n",
    "\n",
    "print(f'Project Root: {PROJECT_ROOT}')\n",
    "print(f'Train CSV: {TRAIN_CSV}')\n",
    "print(f'Images Dir: {IMAGES_DIR}')\n",
    "DATA_DIR.mkdir(exist_ok=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2. Load and Analyze Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load train.csv\n",
    "print('Loading train.csv (this may take a moment)...')\n",
    "df = pd.read_csv(TRAIN_CSV)\n",
    "\n",
    "print(f'\\n{\"=\"*60}')\n",
    "print('DATASET OVERVIEW')\n",
    "print(f'{\"=\"*60}')\n",
    "print(f'Total images:          {len(df):,}')\n",
    "print(f'Unique landmarks:       {df[\"landmark_id\"].nunique():,}')\n",
    "print(f'Columns:               {list(df.columns)}')\n",
    "print(f'Missing values:        {df.isnull().sum().sum()}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Display sample data\n",
    "print('Sample entries:')\n",
    "df.head(10)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3. Class Distribution Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Class distribution\n",
    "class_counts = df['landmark_id'].value_counts()\n",
    "\n",
    "print(f'\\n{\"=\"*60}')\n",
    "print('CLASS DISTRIBUTION')\n",
    "print(f'{\"=\"*60}')\n",
    "print(f'Min images per landmark:    {class_counts.min()}')\n",
    "print(f'Max images per landmark:    {class_counts.max():,}')\n",
    "print(f'Mean images per landmark:   {class_counts.mean():.2f}')\n",
    "print(f'Median images per landmark: {class_counts.median():.2f}')\n",
    "print(f'Std dev:                    {class_counts.std():.2f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot class distribution\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "\n",
    "# Histogram of class sizes\n",
    "axes[0].hist(class_counts.values, bins=50, color='steelblue', edgecolor='white')\n",
    "axes[0].set_xlabel('Number of Images per Landmark', fontsize=12)\n",
    "axes[0].set_ylabel('Frequency', fontsize=12)\n",
    "axes[0].set_title('Distribution of Images per Landmark', fontsize=14, fontweight='bold')\n",
    "axes[0].set_yscale('log')\n",
    "\n",
    "# Cumulative distribution\n",
    "sorted_counts = np.sort(class_counts.values)\n",
    "cumulative = np.arange(1, len(sorted_counts) + 1) / len(sorted_counts)\n",
    "axes[1].plot(sorted_counts, cumulative, color='coral', linewidth=2)\n",
    "axes[1].set_xlabel('Images per Landmark', fontsize=12)\n",
    "axes[1].set_ylabel('Cumulative Proportion of Landmarks', fontsize=12)\n",
    "axes[1].set_title('Cumulative Landmark Distribution', fontsize=14, fontweight='bold')\n",
    "axes[1].set_xscale('log')\n",
    "axes[1].grid(alpha=0.3)\n",
    "\n",
    "# Top 20 landmarks\n",
    "top20 = class_counts.head(20)\n",
    "axes[2].barh(range(len(top20)), top20.values, color='teal')\n",
    "axes[2].set_yticks(range(len(top20)))\n",
    "axes[2].set_yticklabels([f'Landmark {i}' for i in top20.index])\n",
    "axes[2].set_xlabel('Number of Images', fontsize=12)\n",
    "axes[2].set_title('Top 20 Most Populated Landmarks', fontsize=14, fontweight='bold')\n",
    "axes[2].invert_yaxis()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('../images/01_class_distribution.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print('Saved to images/01_class_distribution.png')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 4. Create Training Sample"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# For practical training, we need a balanced sample\n",
    "# Strategy: Select landmarks with at least N images and sample uniformly\n",
    "\n",
    "MIN_IMAGES_PER_LANDMARK = 20  # Minimum images per landmark\n",
    "NUM_CLASSES_TARGET = 500       # Target number of classes\n",
    "SAMPLES_PER_CLASS = 50         # Images to sample per class\n",
    "\n",
    "# Find landmarks with enough images\n",
    "valid_landmarks = class_counts[class_counts >= MIN_IMAGES_PER_LANDMARK].index\n",
    "print(f'Landmarks with >={MIN_IMAGES_PER_LANDMARK} images: {len(valid_landmarks):,}')\n",
    "\n",
    "# Take top N landmarks\n",
    "selected_landmarks = valid_landmarks[:NUM_CLASSES_TARGET]\n",
    "print(f'Selected top {len(selected_landmarks):,} landmarks')\n",
    "\n",
    "# Sample images from each landmark\n",
    "sample_dfs = []\n",
    "for landmark_id in selected_landmarks:\n",
    "    landmark_df = df[df['landmark_id'] == landmark_id]\n",
    "    n_samples = min(SAMPLES_PER_CLASS, len(landmark_df))\n",
    "    sample_dfs.append(landmark_df.sample(n=n_samples, random_state=42))\n",
    "\n",
    "train_sample = pd.concat(sample_dfs, ignore_index=True)\n",
    "\n",
    "print(f'\\nTraining sample created:')\n",
    "print(f'  Total images:  {len(train_sample):,}')\n",
    "print(f'  Unique classes: {train_sample[\"landmark_id\"].nunique():,}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save sample CSV\n",
    "SAMPLE_CSV = DATA_DIR / 'train_sample.csv'\n",
    "train_sample.to_csv(SAMPLE_CSV, index=False)\n",
    "print(f'Sample CSV saved to: {SAMPLE_CSV}')\n",
    "\n",
    "# Also save the landmark ID mapping\n",
    "landmark_mapping = train_sample[['landmark_id']].drop_duplicates().sort_values('landmark_id').reset_index(drop=True)\n",
    "landmark_mapping['class_idx'] = range(len(landmark_mapping))\n",
    "landmark_mapping.to_csv(DATA_DIR / 'landmark_mapping.csv', index=False)\n",
    "print(f'Landmark mapping saved to: {DATA_DIR / \"landmark_mapping.csv\"}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5. Check Downloaded Images"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check how many sample images are downloaded\n",
    "sample_ids = set(train_sample['id'].values)\n",
    "\n",
    "if IMAGES_DIR.exists():\n",
    "    downloaded_ids = {f.stem for f in IMAGES_DIR.glob('*.jpg')}\n",
    "    sample_downloaded = sample_ids & downloaded_ids\n",
    "    \n",
    "    print(f'Images needed for sample: {len(sample_ids):,}')\n",
    "    print(f'Images downloaded:        {len(downloaded_ids):,}')\n",
    "    print(f'Images from sample downloaded: {len(sample_downloaded):,} ({100*len(sample_downloaded)/len(sample_ids):.1f}%)')\n",
    "    \n",
    "    # Show URLs that need downloading\n",
    "    missing_df = train_sample[~train_sample['id'].isin(downloaded_ids)]\n",
    "    print(f'\\nImages still needed: {len(missing_df):,}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 6. Download Instructions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Download sample images\n",
    "print(\"\"\"\n",
    "To download images for training, run:\n",
    "\n",
    "    # Download all images from train.csv:\n",
    "    python download_images.py\n",
    "\n",
    "    # Download only the sample images:\n",
    "    python download_images.py --sample 25000\n",
    "\n",
    "    # Download first 10,000 images (sequential):\n",
    "    python download_images.py --head 10000\n",
    "\n",
    "The download script supports:\n",
    "    - Parallel downloads (50 concurrent)\n",
    "    - Automatic retry on failures\n",
    "    - Resume interrupted downloads\n",
    "    - Progress tracking\n",
    "\"\"\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 7. Sample Dataset for Quick Training"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# For immediate testing, create a small synthetic sample\n",
    "# This lets us test the training pipeline without waiting for downloads\n",
    "\n",
    "NUM_TEST_CLASSES = 50\n",
    "SAMPLES_PER_TEST_CLASS = 30\n",
    "\n",
    "# Get top N classes by frequency\n",
    "test_classes = class_counts.head(NUM_TEST_CLASSES).index.tolist()\n",
    "\n",
    "test_dfs = []\n",
    "for landmark_id in test_classes:\n",
    "    landmark_df = df[df['landmark_id'] == landmark_id]\n",
    "    n = min(SAMPLES_PER_TEST_CLASS, len(landmark_df))\n",
    "    test_dfs.append(landmark_df.sample(n=n, random_state=123))\n",
    "\n",
    "quick_test_sample = pd.concat(test_dfs, ignore_index=True)\n",
    "\n",
    "# Save quick test sample\n",
    "QUICK_TEST_CSV = DATA_DIR / 'quick_test_sample.csv'\n",
    "quick_test_sample.to_csv(QUICK_TEST_CSV, index=False)\n",
    "\n",
    "print(f'Quick test sample created:')\n",
    "print(f'  Total images:   {len(quick_test_sample):,}')\n",
    "print(f'  Unique classes: {quick_test_sample[\"landmark_id\"].nunique():,}')\n",
    "print(f'  Saved to:       {QUICK_TEST_CSV}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 8. Summary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f\"\"\"\n",
    "{\"=\"*60}\n",
    "DATA EXPLORATION SUMMARY\n",
    "{\"=\"*60}\n",
    "\n",
    "Dataset: Google Landmarks Dataset v2\n",
    "- Total images: {len(df):,}\n",
    "- Unique landmarks: {df['landmark_id'].nunique():,}\n",
    "\n",
    "Class Imbalance:\n",
    "- Smallest class: {class_counts.min()} image(s)\n",
    "- Largest class: {class_counts.max():,} images\n",
    "- Mean: {class_counts.mean():.2f}, Median: {class_counts.median():.2f}\n",
    "\n",
    "Created Samples:\n",
    f"- Training sample: {len(train_sample):,} images, {train_sample['landmark_id'].nunique():,} classes\n",
    f"- Quick test sample: {len(quick_test_sample):,} images, {quick_test_sample['landmark_id'].nunique():,} classes\n",
    "\n",
    "Next Steps:\n",
    "1. Run: python download_images.py --sample 25000\n",
    "2. Proceed to 02_Data_Preprocessing.ipynb\n",
    "3. Train with: python landmark_detection.py --mode train\n",
    "\"\"\")"
   ]
  }
